# Runtime
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://your-domain.example

# Core application
DATABASE_URL=mysql://user:password@host:3306/database
JWT_SECRET=replace-with-at-least-32-random-characters
OWNER_OPEN_ID=your-supabase-user-uuid
OWNER_NAME=Your Name

# Supabase Auth (use the project URL and publishable/anon key; never use service_role in the browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Scheduled delivery authentication
CRON_SECRET=replace-with-a-long-random-secret

# AI / built-in services
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=replace-me

# Optional delivery providers
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
REPLY_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional frontend forge variables, if the browser uses them
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# Never commit a real .env file or provider secrets.
